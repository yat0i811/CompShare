SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
CORRECT_PASSWORD=change-me
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# 共有URL（管理画面の share_url）の組み立てに使う公開ドメイン。
# 単一ドメイン統合済みのため、旧 compshareapi.yat0i.com は使わないこと。
FRONTEND_URL=https://compshare.yat0i.com

# 以下は任意項目（既定値あり）。R2の料金改定に追従する場合のみ設定する。
# R2_FREE_STORAGE_GB=10.0
# R2_STORAGE_PRICE_PER_GB_MONTH=0.015
# R2_USAGE_CACHE_TTL_SECONDS=300

# --- R2転送のスレッド/接続数(既定値のまま運用できる。負荷試験時のみ触る) ---
# R2専用スレッドプールのワーカー数。マネージド転送1本が完了待ちで1ワーカーを
# 占有するため、同時圧縮数(2) + 予備(2) = 4 を既定にしている。
# R2_EXECUTOR_MAX_WORKERS=4
# 1本の転送を分割並列転送するときのリクエスト並列数(boto3のTransferConfig(max_concurrency)相当)。
# 全転送で共有されるため、転送ごとにこの本数が増えるわけではない。
# R2_TRANSFER_MAX_CONCURRENCY=4
# botocoreのHTTPコネクションプール上限。4(request)+2(submission)+4(executor)+6(ストリーミング余裕)=16
# R2_MAX_POOL_CONNECTIONS=16
